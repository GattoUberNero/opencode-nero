+				startResize()
+			} else {
+				fit.fit()
+				scheduleSize(t.cols, t.rows)
+				if (restore) {
+					await write(restore)
+					if (typeof local.pty.scrollY === "number") t.scrollToLine(local.pty.scrollY)
+				}
+				startResize()
+			}
